# ==========================================
# GITHUB ACTIONS ENVIRONMENT VARIABLES
# ASSISTANCE MSAADA 2.0
# ==========================================

# Ce fichier liste toutes les variables d'environnement et secrets
# nécessaires pour le fonctionnement du pipeline CI/CD

# ==========================================
# SECRETS À CONFIGURER DANS GITHUB
# ==========================================

# Database Credentials
STAGING_DB_PASSWORD=your_staging_db_password
STAGING_DB_USERNAME=staging_user
PRODUCTION_DB_PASSWORD=your_production_db_password
PRODUCTION_DB_USERNAME=production_user

# JWT Secrets (générer des clés de 256 bits)
STAGING_JWT_SECRET=your_staging_jwt_secret_256_bits
PRODUCTION_JWT_SECRET=your_production_jwt_secret_256_bits

# Application Keys (Laravel APP_KEY format base64:xxx)
STAGING_APP_KEY=base64:your_staging_app_key
PRODUCTION_APP_KEY=base64:your_production_app_key

# Pusher Configuration
STAGING_PUSHER_APP_ID=staging_pusher_app_id
STAGING_PUSHER_APP_KEY=staging_pusher_key
STAGING_PUSHER_APP_SECRET=staging_pusher_secret
STAGING_PUSHER_CLUSTER=eu

PRODUCTION_PUSHER_APP_ID=production_pusher_app_id
PRODUCTION_PUSHER_APP_KEY=production_pusher_key
PRODUCTION_PUSHER_APP_SECRET=production_pusher_secret
PRODUCTION_PUSHER_CLUSTER=eu

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=eu-west-1

# S3 Buckets
STAGING_S3_BUCKET=assistance-msaada-staging
PRODUCTION_S3_BUCKET=assistance-msaada-production
BACKUP_S3_BUCKET=assistance-msaada-backups

# Docker Registry
DOCKER_REGISTRY=registry.assistance-msaada.org
DOCKER_USERNAME=github-actions
DOCKER_PASSWORD=your_registry_password

# SSH Keys pour déploiement
SSH_PRIVATE_KEY=your_ssh_private_key_base64
SSH_PUBLIC_KEY=your_ssh_public_key

# Serveurs de déploiement
STAGING_SERVER=staging.assistance-msaada.org
PRODUCTION_SERVERS=prod1.assistance-msaada.org,prod2.assistance-msaada.org

# Notification Services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_key

# Monitoring & Analytics
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token
GOOGLE_ANALYTICS_ID=GA-XXXXXXXX
HOTJAR_ID=your_hotjar_id

# External APIs
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890

WHATSAPP_API_URL=https://graph.facebook.com/v17.0/
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token

# Security & Encryption
PRODUCTION_SECRETS_PASSPHRASE=your_gpg_passphrase
VBG_ENCRYPTION_KEY_STAGING=your_32_char_encryption_key_staging
VBG_ENCRYPTION_KEY_PRODUCTION=your_32_char_encryption_key_production

# Maps & Geolocation
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# reCAPTCHA
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Social Media Integration
FACEBOOK_APP_ID=your_facebook_app_id
TWITTER_API_KEY=your_twitter_api_key
LINKEDIN_CLIENT_ID=your_linkedin_client_id

# Health Checks & Deployment
DEPLOYMENT_WEBHOOK_URL=https://your-deployment-webhook.com/notify
HEALTH_CHECK_SECRET=your_health_check_secret

# SSL Certificates (Let's Encrypt)
LETSENCRYPT_EMAIL=ssl@assistance-msaada.org

# ==========================================
# VARIABLES PUBLIQUES GITHUB
# ==========================================
# Ces variables peuvent être définies comme variables d'environnement
# publiques dans GitHub Actions (pas de secrets)

ENVIRONMENT_NAME=staging|production
NODE_VERSION=18
PHP_VERSION=8.1
FLUTTER_VERSION=3.13.9

# URLs de base
STAGING_API_URL=https://staging-api.assistance-msaada.org
STAGING_WEB_URL=https://staging.assistance-msaada.org
PRODUCTION_API_URL=https://api.assistance-msaada.org
PRODUCTION_WEB_URL=https://assistance-msaada.org

# Configuration Docker
COMPOSE_PROJECT_NAME=assistance-msaada

# ==========================================
# INSTRUCTIONS DE CONFIGURATION
# ==========================================

# 1. Aller dans Settings > Secrets and variables > Actions
# 2. Ajouter tous les secrets listés ci-dessus dans la section "Repository secrets"
# 3. Ajouter les variables publiques dans la section "Variables"
# 4. Pour les environnements (staging/production) :
#    - Aller dans Settings > Environments
#    - Créer "staging" et "production" environments
#    - Configurer les protection rules et required reviewers pour production
#    - Ajouter les secrets spécifiques à chaque environnement

# ==========================================
# GÉNÉRATION DES CLÉS DE SÉCURITÉ
# ==========================================

# JWT Secret (256 bits base64)
# openssl rand -base64 32

# Laravel APP_KEY
# php artisan key:generate --show

# Encryption Key (32 caractères)
# openssl rand -hex 16

# SSH Key Pair
# ssh-keygen -t rsa -b 4096 -C "github-actions@assistance-msaada.org"
# cat ~/.ssh/id_rsa | base64 -w 0  # Private key pour SSH_PRIVATE_KEY

# GPG Key pour chiffrement des secrets production
# gpg --full-generate-key
# gpg --armor --export-secret-keys > production-secrets.key

