# ===========================================
# ENVIRONMENT STAGING - ASSISTANCE MSAADA
# ===========================================

APP_NAME="Assistance Msaada API - Staging"
APP_ENV=staging
APP_KEY=base64:GENERATE_UNIQUE_KEY_FOR_STAGING
APP_DEBUG=false
APP_URL=https://staging-api.assistance-msaada.org
APP_TIMEZONE=UTC

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# Database Configuration (Staging)
DB_CONNECTION=mysql
DB_HOST=${DB_HOST:-127.0.0.1}
DB_PORT=${DB_PORT:-3306}
DB_DATABASE=assistance_msaada_staging
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# Cache & Sessions
BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis Configuration
REDIS_HOST=${REDIS_HOST:-127.0.0.1}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_DB=1

# Mail Configuration (Staging - SendGrid/SES)
MAIL_MAILER=smtp
MAIL_HOST=${MAIL_HOST:-smtp.sendgrid.net}
MAIL_PORT=${MAIL_PORT:-587}
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="staging@assistance-msaada.org"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 Configuration (Staging)
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-eu-west-1}
AWS_BUCKET=assistance-msaada-staging
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher Configuration (Staging)
PUSHER_APP_ID=${PUSHER_APP_ID}
PUSHER_APP_KEY=${PUSHER_APP_KEY}
PUSHER_APP_SECRET=${PUSHER_APP_SECRET}
PUSHER_HOST=${PUSHER_HOST}
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=${PUSHER_APP_CLUSTER:-eu}

# Frontend Configuration
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_TTL=60
JWT_REFRESH_TTL=20160

# CORS Configuration
SANCTUM_STATEFUL_DOMAINS=staging.assistance-msaada.org,staging-app.assistance-msaada.org

# VBG Platform Specific Settings
VBG_ADMIN_EMAIL=admin@assistance-msaada.org
VBG_REPORTS_PER_PAGE=20
VBG_FILE_MAX_SIZE=20480  # 20MB
VBG_SUPPORTED_LANGUAGES=fr,en,sw
VBG_DEFAULT_LANGUAGE=fr

# Security Settings (Staging)
VBG_ENCRYPTION_KEY=${VBG_ENCRYPTION_KEY}
VBG_AUDIT_RETENTION_DAYS=730
VBG_SESSION_TIMEOUT_MINUTES=30
VBG_MAX_LOGIN_ATTEMPTS=5
VBG_LOCKOUT_DURATION=30

# External Services (Staging)
TWILIO_SID=${TWILIO_SID}
TWILIO_TOKEN=${TWILIO_TOKEN}
TWILIO_FROM=${TWILIO_FROM}

# WhatsApp Integration (Staging)
WHATSAPP_API_URL=${WHATSAPP_API_URL}
WHATSAPP_ACCESS_TOKEN=${WHATSAPP_ACCESS_TOKEN}

# SMS Gateway (Staging)
SMS_PROVIDER=twilio
SMS_DEFAULT_FROM=${SMS_DEFAULT_FROM}

# Notification Settings
NOTIFICATION_QUEUE=default
ALERT_QUEUE=high

# Development Tools (Disabled in staging)
TELESCOPE_ENABLED=true
DEBUGBAR_ENABLED=false
CLOCKWORK_ENABLED=false

# Rate Limiting (Production-like)
THROTTLE_LOGIN_ATTEMPTS=5
THROTTLE_API_REQUESTS=300

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.1

# SSL Configuration
FORCE_HTTPS=true
SECURE_HEADERS=true