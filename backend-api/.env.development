# ===========================================
# ENVIRONMENT DEVELOPMENT - ASSISTANCE MSAADA
# ===========================================

APP_NAME="Assistance Msaada API - Development"
APP_ENV=development
APP_KEY=base64:GENERATE_IN_PRODUCTION
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assistance_msaada_dev
DB_USERNAME=root
DB_PASSWORD=password

# Cache & Sessions
BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Mail Configuration (Development - MailHog/Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="dev@assistance-msaada.org"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (Development - LocalStack ou MinIO)
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=assistance-msaada-dev
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Pusher Configuration (Development)
PUSHER_APP_ID=local
PUSHER_APP_KEY=local-key
PUSHER_APP_SECRET=local-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Frontend Configuration
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# JWT Configuration
JWT_SECRET=GENERATE_JWT_SECRET_IN_PRODUCTION
JWT_TTL=60
JWT_REFRESH_TTL=20160

# CORS Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8080,127.0.0.1,127.0.0.1:8000,::1,127.0.0.1:5173

# VBG Platform Specific Settings
VBG_ADMIN_EMAIL=admin@assistance-msaada.org
VBG_REPORTS_PER_PAGE=20
VBG_FILE_MAX_SIZE=10240  # 10MB
VBG_SUPPORTED_LANGUAGES=fr,en,sw
VBG_DEFAULT_LANGUAGE=fr

# Security Settings (Development)
VBG_ENCRYPTION_KEY=dev-encryption-key-32-chars!!
VBG_AUDIT_RETENTION_DAYS=365
VBG_SESSION_TIMEOUT_MINUTES=30
VBG_MAX_LOGIN_ATTEMPTS=5
VBG_LOCKOUT_DURATION=30

# External Services (Development)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_FROM=+1234567890

# WhatsApp Integration (Development)
WHATSAPP_API_URL=https://api.whatsapp.com/dev
WHATSAPP_ACCESS_TOKEN=dev_token

# SMS Gateway (Development)
SMS_PROVIDER=twilio
SMS_DEFAULT_FROM=+243123456789

# Notification Settings
NOTIFICATION_QUEUE=high
ALERT_QUEUE=critical

# Development Tools
TELESCOPE_ENABLED=true
DEBUGBAR_ENABLED=true
CLOCKWORK_ENABLED=true

# Rate Limiting (Relaxed for development)
THROTTLE_LOGIN_ATTEMPTS=10
THROTTLE_API_REQUESTS=1000