# ===========================================
# ENVIRONMENT PRODUCTION - FRONTEND REACT
# ===========================================

# App Configuration
VITE_APP_NAME="Assistance Msaada"
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# API Configuration
VITE_API_BASE_URL=https://api.assistance-msaada.org/api/v1
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Frontend URLs
VITE_APP_URL=https://assistance-msaada.org
VITE_PUBLIC_URL=https://assistance-msaada.org

# CDN Configuration
VITE_CDN_URL=https://cdn.assistance-msaada.org

# WebSocket Configuration
VITE_WEBSOCKET_URL=wss://ws.assistance-msaada.org
VITE_PUSHER_APP_KEY=${VITE_PUSHER_APP_KEY}
VITE_PUSHER_CLUSTER=eu
VITE_PUSHER_HOST=ws-eu.pusher.com
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https

# Authentication
VITE_JWT_STORAGE_KEY=assistance_msaada_token
VITE_JWT_REFRESH_KEY=assistance_msaada_refresh
VITE_SESSION_TIMEOUT=900000  # 15 minutes in ms (stricter for production)

# Features Flags (Production)
VITE_FEATURE_VOICE_REPORTS=true
VITE_FEATURE_CHAT_ENCRYPTION=true
VITE_FEATURE_BIOMETRIC_AUTH=true
VITE_FEATURE_OFFLINE_MODE=true
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_DEBUG_MODE=false

# Language Configuration
VITE_DEFAULT_LANGUAGE=fr
VITE_SUPPORTED_LANGUAGES=fr,en,sw
VITE_RTL_LANGUAGES=ar

# Maps & Geolocation (Production)
VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY}
VITE_MAPBOX_ACCESS_TOKEN=${VITE_MAPBOX_ACCESS_TOKEN}
VITE_ENABLE_GEOLOCATION=true

# Upload Configuration (Production - Generous limits)
VITE_MAX_FILE_SIZE=52428800  # 50MB
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,audio/mpeg,audio/wav,video/mp4
VITE_MAX_FILES_PER_UPLOAD=15

# Logging & Debugging (Production - Minimal)
VITE_LOG_LEVEL=error
VITE_ENABLE_CONSOLE_LOGS=false
VITE_ENABLE_REDUX_DEVTOOLS=false
VITE_ENABLE_REACT_DEVTOOLS=false

# Error Tracking (Production)
VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_SAMPLE_RATE=0.1  # 10% sampling for production

# Performance Monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_ID=${VITE_ANALYTICS_ID}

# Additional Analytics
VITE_GOOGLE_ANALYTICS_ID=${VITE_GOOGLE_ANALYTICS_ID}
VITE_HOTJAR_ID=${VITE_HOTJAR_ID}

# Security (Production - Maximum Security)
VITE_CSP_ENABLED=true
VITE_HTTPS_ONLY=true
VITE_SECURE_COOKIES=true
VITE_HSTS_ENABLED=true

# Production Build Settings
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true
VITE_BUILD_TARGET=es2020
VITE_BUILD_CHUNKS=true

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_THEME_PERSISTENCE=true

# Notification Configuration
VITE_NOTIFICATION_POSITION=top-right
VITE_NOTIFICATION_TIMEOUT=5000

# Cache Configuration (Production - Aggressive caching)
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=86400000  # 24 hours
VITE_SW_CACHE_ENABLED=true
VITE_SW_CACHE_STRATEGY=CacheFirst

# PWA Configuration (Production)
VITE_PWA_ENABLED=true
VITE_PWA_OFFLINE_ENABLED=true
VITE_PWA_PUSH_NOTIFICATIONS=true
VITE_PWA_INSTALL_PROMPT=true

# Social Media Integration
VITE_FACEBOOK_APP_ID=${VITE_FACEBOOK_APP_ID}
VITE_TWITTER_API_KEY=${VITE_TWITTER_API_KEY}
VITE_LINKEDIN_CLIENT_ID=${VITE_LINKEDIN_CLIENT_ID}

# External Services
VITE_RECAPTCHA_SITE_KEY=${VITE_RECAPTCHA_SITE_KEY}
VITE_TURNSTILE_SITE_KEY=${VITE_TURNSTILE_SITE_KEY}

# Content Security
VITE_CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.assistance-msaada.org wss://ws.assistance-msaada.org;"

# Rate Limiting (Client-side)
VITE_API_RATE_LIMIT=100  # Requests per minute
VITE_UPLOAD_RATE_LIMIT=10  # Uploads per hour

# Feature Gates
VITE_MAINTENANCE_MODE=false
VITE_REGISTRATION_ENABLED=true
VITE_GUEST_ACCESS_ENABLED=false

# Monitoring URLs
VITE_HEALTH_CHECK_URL=https://api.assistance-msaada.org/health
VITE_STATUS_PAGE_URL=https://status.assistance-msaada.org

# Legal & Compliance
VITE_PRIVACY_POLICY_URL=https://assistance-msaada.org/privacy
VITE_TERMS_OF_SERVICE_URL=https://assistance-msaada.org/terms
VITE_GDPR_COMPLIANCE=true

# Contact Information
VITE_SUPPORT_EMAIL=support@assistance-msaada.org
VITE_EMERGENCY_HOTLINE=+243-XXX-XXX-XXX
VITE_SUPPORT_CHAT_ENABLED=true

# Backup & Recovery
VITE_BACKUP_STORAGE_KEY=assistance_msaada_backup
VITE_AUTO_BACKUP_INTERVAL=3600000  # 1 hour

# Accessibility
VITE_HIGH_CONTRAST_MODE=true
VITE_SCREEN_READER_SUPPORT=true
VITE_KEYBOARD_NAVIGATION=true

# Mobile App Integration
VITE_MOBILE_APP_DEEP_LINK_SCHEME=assistance-msaada
VITE_MOBILE_APP_STORE_URL=https://apps.apple.com/app/assistance-msaada
VITE_MOBILE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=org.assistance.msaada