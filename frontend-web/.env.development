# ===========================================
# ENVIRONMENT DEVELOPMENT - FRONTEND REACT
# ===========================================

# App Configuration
VITE_APP_NAME="Assistance Msaada - Development"
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0-dev

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Frontend URLs
VITE_APP_URL=http://localhost:3000
VITE_PUBLIC_URL=http://localhost:3000

# WebSocket Configuration
VITE_WEBSOCKET_URL=ws://localhost:6001
VITE_PUSHER_APP_KEY=local-key
VITE_PUSHER_CLUSTER=mt1
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http

# Authentication
VITE_JWT_STORAGE_KEY=assistance_msaada_token
VITE_JWT_REFRESH_KEY=assistance_msaada_refresh
VITE_SESSION_TIMEOUT=1800000  # 30 minutes in ms

# Features Flags (Development)
VITE_FEATURE_VOICE_REPORTS=true
VITE_FEATURE_CHAT_ENCRYPTION=true
VITE_FEATURE_BIOMETRIC_AUTH=false  # Disabled in dev
VITE_FEATURE_OFFLINE_MODE=true
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_DEBUG_MODE=true

# Language Configuration
VITE_DEFAULT_LANGUAGE=fr
VITE_SUPPORTED_LANGUAGES=fr,en,sw
VITE_RTL_LANGUAGES=ar

# Maps & Geolocation (Development)
VITE_GOOGLE_MAPS_API_KEY=your_dev_google_maps_key
VITE_MAPBOX_ACCESS_TOKEN=your_dev_mapbox_token
VITE_ENABLE_GEOLOCATION=true

# Upload Configuration
VITE_MAX_FILE_SIZE=10485760  # 10MB
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,audio/mpeg
VITE_MAX_FILES_PER_UPLOAD=5

# Logging & Debugging (Development)
VITE_LOG_LEVEL=debug
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_REACT_DEVTOOLS=true

# Error Tracking (Development)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_SAMPLE_RATE=1.0

# Performance Monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ANALYTICS_ENABLED=false  # Disabled in dev

# Security (Development - Relaxed)
VITE_CSP_ENABLED=false
VITE_HTTPS_ONLY=false
VITE_SECURE_COOKIES=false

# Development Tools
VITE_HOT_RELOAD=true
VITE_FAST_REFRESH=true
VITE_SOURCE_MAPS=true

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_THEME_PERSISTENCE=true

# Notification Configuration
VITE_NOTIFICATION_POSITION=top-right
VITE_NOTIFICATION_TIMEOUT=5000

# Cache Configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=3600000  # 1 hour
VITE_SW_CACHE_ENABLED=false  # Service Worker cache

# Development Server
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_HOST=localhost