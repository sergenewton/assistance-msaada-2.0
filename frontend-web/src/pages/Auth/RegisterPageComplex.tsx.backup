import React, { useState } from 'react'
import { useForm } from 'react-hook-form'
import { zodResolver } from '@hookform/resolvers/zod'
import { Link, useNavigate } from 'react-router-dom'
import { z } from 'zod'
import { useAuthHook } from '../../hooks/useAuthHook'
import {
  Eye,
  EyeOff,
  Lock,
  Mail,
  Phone,
  User,
  MapPin,
  Camera,
  Upload,
  HelpCircle
} from 'lucide-react'

// Schéma de validation pour l'inscription
const registerSchema = z.object({
  username: z.string()
    .min(3, 'Le nom d\'utilisateur doit contenir au moins 3 caractères')
    .max(20, 'Le nom d\'utilisateur ne peut pas dépasser 20 caractères')
    .regex(/^[a-zA-Z0-9_]+$/, 'Le nom d\'utilisateur ne peut contenir que des lettres, chiffres et underscores'),
  fullName: z.string()
    .min(2, 'Le nom complet doit contenir au moins 2 caractères')
    .max(100, 'Le nom complet ne peut pas dépasser 100 caractères'),
  email: z.string()
    .email('Format d\'email invalide')
    .min(1, 'L\'email est obligatoire'),
  phone: z.string()
    .min(10, 'Le numéro de téléphone doit contenir au moins 10 chiffres')
    .regex(/^\+?[0-9\s-()]+$/, 'Format de téléphone invalide'),
  password: z.string()
    .min(6, 'Le mot de passe doit contenir au moins 6 caractères'),
  confirmPassword: z.string(),
  role: z.enum(['operateur', 'aps', 'organisation'], {
    errorMap: () => ({ message: 'Veuillez sélectionner un rôle valide' })
  }),
  location: z.string().optional(),
  gpsCoordinates: z.string().optional(),
  profilePhoto: z.string().optional(),
  organizationTypes: z.array(z.string()).optional(),
  customOrganizationTypes: z.string().optional()
}).refine((data) => data.password === data.confirmPassword, {
  message: 'Les mots de passe ne correspondent pas',
  path: ['confirmPassword']
})

type RegisterFormData = z.infer<typeof registerSchema>

// Options de rôles
const roleOptions = [
  { value: 'operateur', label: 'Opérateur Centre d\'écoute' },
  { value: 'aps', label: 'Agent Psychosocial (APS)' },
  { value: 'organisation', label: 'Organisation partenaire' }
]

// Types d'organisations
const organizationTypeOptions = [
  { value: 'medical', label: 'Soins médicaux', description: 'Services médicaux, soins d\'urgence, suivi médical' },
  { value: 'psychological', label: 'Accompagnement psychologique', description: 'Counseling, thérapie individuelle et de groupe' },
  { value: 'legal', label: 'Assistance juridique', description: 'Conseil juridique, représentation en justice' },
  { value: 'security', label: 'Sécurité et protection', description: 'Services de police, protection des victimes' },
  { value: 'shelter', label: 'Hébergement d\'urgence', description: 'Foyers sécurisés, hébergement temporaire' },
  { value: 'economic', label: 'Réinsertion économique', description: 'Formation professionnelle, micro-crédit' },
  { value: 'social', label: 'Accompagnement social', description: 'Médiation familiale, réinsertion sociale' },
  { value: 'education', label: 'Éducation et sensibilisation', description: 'Formation, sensibilisation communautaire' },
] as const

// Composant Tooltip
const Tooltip = ({ text, children }: { text: string; children: React.ReactNode }) => {
  const [show, setShow] = useState(false)
  
  return (
    <span 
      className="relative inline-block"
      onMouseEnter={() => setShow(true)}
      onMouseLeave={() => setShow(false)}
    >
      {children}
      {show && (
        <div className="absolute z-10 px-3 py-2 text-sm text-white bg-gray-800 rounded-lg shadow-lg -top-2 left-6 transform -translate-y-full w-64">
          {text}
          <div className="absolute top-full left-2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-800"></div>
        </div>
      )}
    </span>
  )
}

export const RegisterPage: React.FC = () => {
  const navigate = useNavigate()
  const { register: registerUser, isLoading, error, clearError } = useAuthHook()
  const [showPassword, setShowPassword] = useState(false)
  const [showConfirmPassword, setShowConfirmPassword] = useState(false)
  const [profilePhoto, setProfilePhoto] = useState<File | null>(null)
  const [profilePhotoPreview, setProfilePhotoPreview] = useState<string | null>(null)
  const [selectedOrgTypes, setSelectedOrgTypes] = useState<string[]>([])
  const [customOrgTypes, setCustomOrgTypes] = useState<string>('')
  const [locationLoading, setLocationLoading] = useState(false)

  const {
    register,
    handleSubmit,
    watch,
    setValue,
    formState: { errors, isSubmitting }
  } = useForm<RegisterFormData>({
    resolver: zodResolver(registerSchema),
    mode: 'onChange'
  })

  const selectedRole = watch('role')

  // Fonction pour gérer le changement de photo
  const handlePhotoChange = (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0]
    if (file) {
      setProfilePhoto(file)
      const reader = new FileReader()
      reader.onloadend = () => {
        setProfilePhotoPreview(reader.result as string)
        setValue('profilePhoto', reader.result as string)
      }
      reader.readAsDataURL(file)
    }
  }

  // Fonction pour récupérer la position GPS
  const getCurrentLocation = () => {
    if (!navigator.geolocation) {
      alert('La géolocalisation n\'est pas supportée par ce navigateur.')
      return
    }

    setLocationLoading(true)
    navigator.geolocation.getCurrentPosition(
      (position) => {
        const { latitude, longitude } = position.coords
        const coordinates = `${latitude}, ${longitude}`
        setValue('gpsCoordinates', coordinates)
        setLocationLoading(false)
      },
      (error) => {
        console.error('Erreur de géolocalisation:', error)
        alert('Impossible d\'obtenir votre position. Vérifiez les autorisations de géolocalisation.')
        setLocationLoading(false)
      }
    )
  }

  // Fonction pour gérer les types d'organisation
  const handleOrgTypeChange = (type: string, checked: boolean) => {
    if (checked) {
      setSelectedOrgTypes(prev => [...prev, type])
    } else {
      setSelectedOrgTypes(prev => prev.filter(t => t !== type))
    }
  }

  // Soumission du formulaire
  const onSubmit = async (data: RegisterFormData) => {
    try {
      clearError?.()
      
      // Préparer les données d'organisation si applicable
      const organizationData = selectedRole === 'organisation' ? {
        organizationTypes: selectedOrgTypes,
        customOrganizationTypes: customOrgTypes.split(';').map(t => t.trim()).filter(t => t.length > 0)
      } : {}

      const submitData = {
        username: data.username,
        fullName: data.fullName,
        email: data.email,
        phone: data.phone,
        password: data.password,
        password_confirmation: data.confirmPassword,
        role: data.role,
        location: data.location,
        gpsCoordinates: data.gpsCoordinates,
        profilePhoto: data.profilePhoto,
        terms_accepted: true,
        privacy_policy_accepted: true,
        ...organizationData
      }

      await registerUser(submitData)
      navigate('/auth/login', { 
        state: { 
          message: 'Compte créé avec succès ! Votre compte est en attente d\'approbation.' 
        }
      })
    } catch (error) {
      console.error('Erreur lors de l\'inscription:', error)
    }
  }

  return (
    <div className="min-h-screen bg-gray-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
      <div className="max-w-md w-full">
        {/* Logo et titre */}
        <div className="text-center mb-8">
          <div className="flex justify-center mb-4">
            <div className="w-16 h-16 bg-emerald-500 rounded-2xl flex items-center justify-center">
              <svg width="32" height="32" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M32 16C38.627 16 44 21.373 44 28C44 34.627 38.627 40 32 40C25.373 40 20 34.627 20 28C20 21.373 25.373 16 32 16Z" fill="white"/>
                <path d="M28 26C29.1046 26 30 25.1046 30 24C30 22.8954 29.1046 22 28 22C26.8954 22 26 22.8954 26 24C26 25.1046 26.8954 26 28 26Z" fill="#10B981"/>
                <path d="M36 26C37.1046 26 38 25.1046 38 24C38 22.8954 37.1046 22 36 22C34.8954 22 34 22.8954 34 24C34 25.1046 34.8954 26 36 26Z" fill="#10B981"/>
                <path d="M28 34C28 31.7909 29.7909 30 32 30C34.2091 30 36 31.7909 36 34H28Z" fill="#10B981"/>
                <rect x="16" y="44" width="32" height="4" rx="2" fill="white"/>
                <rect x="20" y="52" width="24" height="2" rx="1" fill="white"/>
              </svg>
            </div>
          </div>
          <h2 className="text-2xl font-semibold text-gray-900 mb-2">
            Créer un compte
          </h2>
          <p className="text-sm text-gray-600">
            Rejoignez la plateforme Assistance Msaada 2.0
          </p>
        </div>

        {/* Formulaire */}
        <div className="bg-white shadow-lg rounded-lg px-8 py-6")

          {/* Affichage des erreurs */}
          {error && (
            <div className="mb-6 bg-red-50 border border-red-200 rounded-lg p-4 flex items-center justify-between">
              <div className="flex items-center">
                <div className="text-red-600 text-sm">{error}</div>
              </div>
              <button
                onClick={clearError}
                className="text-red-500 hover:text-red-700 text-lg font-semibold"
              >
                ×
              </button>
            </div>
          )}

          {/* Formulaire en deux colonnes */}
          <form onSubmit={handleSubmit(onSubmit)} className="space-y-8" noValidate>
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
              {/* Colonne Gauche - Informations personnelles */}
              <div className="space-y-6">
                <h3 className="text-lg font-medium text-gray-900 border-b border-gray-200 pb-2">
                  Informations personnelles
                </h3>
                
                {/* Photo de profil */}
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">
                    Photo de profil
                    <Tooltip text="Ajoutez une photo pour personnaliser votre profil. Formats acceptés: JPG, PNG (max 5MB)">
                      <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                    </Tooltip>
                  </label>
                  <div className="flex items-center space-x-4">
                    <div className="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center overflow-hidden">
                      {profilePhotoPreview ? (
                        <img src={profilePhotoPreview} alt="Aperçu" className="w-full h-full object-cover" />
                      ) : (
                        <Camera className="h-8 w-8 text-gray-400" />
                      )}
                    </div>
                    <div>
                      <input
                        type="file"
                        accept="image/*"
                        onChange={handlePhotoChange}
                        className="hidden"
                        id="photo-upload"
                      />
                      <label
                        htmlFor="photo-upload"
                        className="cursor-pointer inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
                      >
                        <Upload className="h-4 w-4 mr-2" />
                        Choisir une photo
                      </label>
                    </div>
                  </div>
                </div>

                {/* Nom d'utilisateur */}
                <div>
                  <label htmlFor="username" className="block text-sm font-medium text-gray-700 mb-2">
                    Nom d'utilisateur <span className="text-red-500">*</span>
                    <Tooltip text="Choisissez un nom unique qui vous identifiera sur la plateforme (3-20 caractères)">
                      <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                    </Tooltip>
                  </label>
                  <div className="relative">
                    <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <User className="h-5 w-5 text-gray-400" />
                    </div>
                    <input
                      id="username"
                      type="text"
                      className={`w-full pl-10 pr-4 py-3 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors ${
                        errors.username ? 'border-red-300 bg-red-50' : 'border-gray-300'
                      }`}
                      placeholder="nom_utilisateur"
                      {...register('username')}
                    />
                  </div>
                  {errors.username && (
                    <p className="mt-2 text-sm text-red-600">{errors.username.message}</p>
                  )}
                </div>

                {/* Nom complet */}
                <div>
                  <label htmlFor="fullName" className="block text-sm font-medium text-gray-700 mb-2">
                    Nom complet <span className="text-red-500">*</span>
                    <Tooltip text="Votre nom complet tel qu'il apparaîtra sur vos documents officiels">
                      <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                    </Tooltip>
                  </label>
                  <input
                    id="fullName"
                    type="text"
                    className={`w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors ${
                      errors.fullName ? 'border-red-300 bg-red-50' : 'border-gray-300'
                    }`}
                    placeholder="Prénom Nom"
                    {...register('fullName')}
                  />
                  {errors.fullName && (
                    <p className="mt-2 text-sm text-red-600">{errors.fullName.message}</p>
                  )}
                </div>

                {/* Email */}
                <div>
                  <label htmlFor="email" className="block text-sm font-medium text-gray-700 mb-2">
                    Email professionnel <span className="text-red-500">*</span>
                    <Tooltip text="Adresse email professionnelle valide pour recevoir les notifications importantes">
                      <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                    </Tooltip>
                  </label>
                  <div className="relative">
                    <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <Mail className="h-5 w-5 text-gray-400" />
                    </div>
                    <input
                      id="email"
                      type="email"
                      className={`w-full pl-10 pr-4 py-3 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors ${
                        errors.email ? 'border-red-300 bg-red-50' : 'border-gray-300'
                      }`}
                      placeholder="votre@email.com"
                      {...register('email')}
                    />
                  </div>
                  {errors.email && (
                    <p className="mt-2 text-sm text-red-600">{errors.email.message}</p>
                  )}
                </div>

                {/* Téléphone */}
                <div>
                  <label htmlFor="phone" className="block text-sm font-medium text-gray-700 mb-2">
                    Téléphone <span className="text-red-500">*</span>
                    <Tooltip text="Numéro de téléphone mobile pour les communications urgentes et la vérification">
                      <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                    </Tooltip>
                  </label>
                  <div className="relative">
                    <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <Phone className="h-5 w-5 text-gray-400" />
                    </div>
                    <input
                      id="phone"
                      type="tel"
                      className={`w-full pl-10 pr-4 py-3 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors ${
                        errors.phone ? 'border-red-300 bg-red-50' : 'border-gray-300'
                      }`}
                      placeholder="+243 XXX XXX XXX"
                      {...register('phone')}
                    />
                  </div>
                  {errors.phone && (
                    <p className="mt-2 text-sm text-red-600">{errors.phone.message}</p>
                  )}
                </div>
              </div>

              {/* Colonne Droite - Informations professionnelles */}
              <div className="space-y-6">
                <h3 className="text-lg font-medium text-gray-900 border-b border-gray-200 pb-2">
                  Informations professionnelles
                </h3>

                {/* Rôle */}
                <div>
                  <label htmlFor="role" className="block text-sm font-medium text-gray-700 mb-2">
                    Rôle <span className="text-red-500">*</span>
                    <Tooltip text="Sélectionnez votre fonction dans la prise en charge des cas VBG">
                      <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                    </Tooltip>
                  </label>
                  <select
                    id="role"
                    className={`w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors ${
                      errors.role ? 'border-red-300 bg-red-50' : 'border-gray-300'
                    }`}
                    {...register('role')}
                    defaultValue=""
                  >
                    <option value="" disabled>Sélectionner un rôle</option>
                    {roleOptions.map((option) => (
                      <option key={option.value} value={option.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                  {errors.role && (
                    <p className="mt-2 text-sm text-red-600">{errors.role.message}</p>
                  )}
                </div>

                {/* Position géographique */}
                <div>
                  <label htmlFor="location" className="block text-sm font-medium text-gray-700 mb-2">
                    Localisation
                    <Tooltip text="Votre position géographique pour faciliter l'attribution des cas locaux">
                      <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                    </Tooltip>
                  </label>
                  <div className="space-y-3">
                    <div className="relative">
                      <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <MapPin className="h-5 w-5 text-gray-400" />
                      </div>
                      <input
                        id="location"
                        type="text"
                        className="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors"
                        placeholder="Ville, Commune, Quartier..."
                        {...register('location')}
                      />
                    </div>
                    <div className="flex items-center space-x-2">
                      <input
                        id="gpsCoordinates"
                        type="text"
                        className="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors text-sm"
                        placeholder="Coordonnées GPS (automatique)"
                        {...register('gpsCoordinates')}
                        readOnly
                      />
                      <button
                        type="button"
                        onClick={getCurrentLocation}
                        disabled={locationLoading}
                        className="px-4 py-2 bg-emerald-500 text-white rounded-lg hover:bg-emerald-600 disabled:opacity-50 transition-colors text-sm flex items-center space-x-1"
                      >
                        {locationLoading ? (
                          <div className="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
                        ) : (
                          <MapPin className="h-4 w-4" />
                        )}
                        <span>{locationLoading ? 'Localisation...' : 'GPS'}</span>
                      </button>
                    </div>
                  </div>
                </div>

                {/* Mot de passe */}
                <div>
                  <label htmlFor="password" className="block text-sm font-medium text-gray-700 mb-2">
                    Mot de passe <span className="text-red-500">*</span>
                    <Tooltip text="Mot de passe sécurisé d'au moins 6 caractères avec majuscules, minuscules et chiffres">
                      <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                    </Tooltip>
                  </label>
                  <div className="relative">
                    <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <Lock className="h-5 w-5 text-gray-400" />
                    </div>
                    <input
                      id="password"
                      type={showPassword ? 'text' : 'password'}
                      className={`w-full pl-10 pr-10 py-3 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors ${
                        errors.password ? 'border-red-300 bg-red-50' : 'border-gray-300'
                      }`}
                      placeholder="Min. 6 caractères"
                      {...register('password')}
                    />
                    <button
                      type="button"
                      className="absolute inset-y-0 right-0 pr-3 flex items-center"
                      onClick={() => setShowPassword(!showPassword)}
                    >
                      {showPassword ? (
                        <EyeOff className="h-5 w-5 text-gray-400 hover:text-gray-600" />
                      ) : (
                        <Eye className="h-5 w-5 text-gray-400 hover:text-gray-600" />
                      )}
                    </button>
                  </div>
                  {errors.password && (
                    <p className="mt-2 text-sm text-red-600">{errors.password.message}</p>
                  )}
                </div>

                {/* Confirmer le mot de passe */}
                <div>
                  <label htmlFor="confirmPassword" className="block text-sm font-medium text-gray-700 mb-2">
                    Confirmer le mot de passe <span className="text-red-500">*</span>
                  </label>
                  <div className="relative">
                    <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <Lock className="h-5 w-5 text-gray-400" />
                    </div>
                    <input
                      id="confirmPassword"
                      type={showConfirmPassword ? 'text' : 'password'}
                      className={`w-full pl-10 pr-10 py-3 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors ${
                        errors.confirmPassword ? 'border-red-300 bg-red-50' : 'border-gray-300'
                      }`}
                      placeholder="Confirmer le mot de passe"
                      {...register('confirmPassword')}
                    />
                    <button
                      type="button"
                      className="absolute inset-y-0 right-0 pr-3 flex items-center"
                      onClick={() => setShowConfirmPassword(!showConfirmPassword)}
                    >
                      {showConfirmPassword ? (
                        <EyeOff className="h-5 w-5 text-gray-400 hover:text-gray-600" />
                      ) : (
                        <Eye className="h-5 w-5 text-gray-400 hover:text-gray-600" />
                      )}
                    </button>
                  </div>
                  {errors.confirmPassword && (
                    <p className="mt-2 text-sm text-red-600">{errors.confirmPassword.message}</p>
                  )}
                </div>
              </div>
            </div>

            {/* Section spéciale pour les organisations partenaires */}
            {selectedRole === 'organisation' && (
              <div className="border-t border-gray-200 pt-6">
                <h3 className="text-lg font-medium text-gray-900 mb-4">
                  Types de prise en charge offerts
                  <Tooltip text="Sélectionnez les types de services que votre organisation peut offrir aux survivantes">
                    <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                  </Tooltip>
                </h3>
                
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                  {organizationTypeOptions.map((option) => (
                    <label key={option.value} className="flex items-start space-x-3 p-3 border border-gray-200 rounded-lg hover:border-emerald-300 transition-colors cursor-pointer">
                      <input
                        type="checkbox"
                        className="mt-1 h-4 w-4 text-emerald-600 focus:ring-emerald-500 border-gray-300 rounded"
                        checked={selectedOrgTypes.includes(option.value)}
                        onChange={(e) => handleOrgTypeChange(option.value, e.target.checked)}
                      />
                      <div className="flex-1">
                        <div className="font-medium text-gray-900">{option.label}</div>
                        <div className="text-sm text-gray-600">{option.description}</div>
                      </div>
                    </label>
                  ))}
                </div>

                {/* Types personnalisés */}
                <div>
                  <label htmlFor="customTypes" className="block text-sm font-medium text-gray-700 mb-2">
                    Autres types de prise en charge
                    <Tooltip text="Saisissez d'autres services séparés par des points-virgules (ex: Formation; Médiation; Hébergement spécialisé)">
                      <HelpCircle className="inline ml-1 h-4 w-4 text-gray-400" />
                    </Tooltip>
                  </label>
                  <textarea
                    id="customTypes"
                    className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors"
                    placeholder="Formation spécialisée; Médiation communautaire; Autre service..."
                    rows={3}
                    value={customOrgTypes}
                    onChange={(e) => setCustomOrgTypes(e.target.value)}
                  />
                  <p className="mt-1 text-sm text-gray-500">Séparez les différents types par des points-virgules</p>
                </div>
              </div>
            )}
            
            {/* Note */}
            <div className="bg-amber-50 border border-amber-200 rounded-lg p-4">
              <p className="text-sm text-amber-700">
                <span className="font-medium">Note :</span> Votre compte sera en attente d'approbation par l'administrateur système avant de pouvoir accéder à la plateforme.
              </p>
            </div>

            {/* Bouton de création de compte */}
            <button
              type="submit"
              disabled={isSubmitting || isLoading}
              className="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-medium py-3 px-4 rounded-lg transition-colors focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {isSubmitting || isLoading ? 'Création en cours...' : 'Créer mon compte'}
            </button>
          </form>

          {/* Lien connexion */}
          <div className="mt-6 text-center">
            <p className="text-sm text-gray-600">
              Vous avez déjà un compte ?{' '}
              <Link
                to="/auth/login"
                className="font-medium text-emerald-600 hover:text-emerald-500"
              >
                Se connecter
              </Link>
            </p>
          </div>
        </div>
      </div>

      {/* Colonne droite - Image */}
      <div className="hidden lg:block lg:w-1/2 xl:w-2/5">
        <img
          className="h-full w-full object-cover"
          src="/public/register-illustration.jpg"
          alt="Assistance médicale"
        />
      </div>
    </div>
  )
}